# Server
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-jwt-secret-min-32-characters-long

# Rate Limiting (defaults: 100 requests per 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# GreenAPI (WhatsApp gateway) — https://green-api.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_BASE_URL=https://YOUR_INSTANCE_NUMBER.api.greenapi.com
GREENAPI_WEBHOOK_TOKEN=

# OpenRouter AI — https://openrouter.ai
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-3.1-pro-preview

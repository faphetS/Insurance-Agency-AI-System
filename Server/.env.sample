# ============================================================================
# Server environment template.
# Copy to `Server/.env` and fill in real values. Never commit `.env`.
# Schema source of truth: Server/src/config/env.ts
#
# Production deployment: Hostinger VPS
#   IP:        187.127.224.73
#   Hostname:  srv1622531.hstgr.cloud
#   Path:      /opt/app  (Server/ is a subdir)
#   Process:   PM2 → `insurance-api`
#   Deploy:   .github/workflows/deploy-vps.yml (auto on push to main, Server/**)
#   Frontend: https://insurance-agency-ai.vercel.app (Vercel)
# ============================================================================

# Server
NODE_ENV=development
PORT=3000
# Prod values:
#   BACKEND_URL=https://srv1622531.hstgr.cloud
#   FRONTEND_URL=https://insurance-agency-ai.vercel.app
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database — self-hosted PostgreSQL on the Hostinger VPS (same box as the app)
# Prod: DATABASE_URL=postgresql://app:STRONG_PASSWORD@localhost:5432/insurance
DATABASE_URL=postgresql://app:password@localhost:5432/insurance
DATABASE_POOL_MAX=10

# File storage — local filesystem (replaces the Supabase Storage bucket).
# Uploads are written under <STORAGE_DIR>/client-documents and served via signed /files URLs.
STORAGE_DIR=./storage

# Auth — single static bearer token protecting admin/inspector endpoints (min 16 chars).
# Send as: Authorization: Bearer <ADMIN_API_TOKEN>
ADMIN_API_TOKEN=change-me-to-a-long-random-admin-token

# Secret used to HMAC-sign the temporary /files download URLs (min 32 chars)
JWT_SECRET=your-secret-min-32-characters-long-for-file-url-signing

# Rate Limiting (defaults: 100 requests per 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging — fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# CORS (comma-separated origins)
# Prod: ALLOWED_ORIGINS=https://insurance-agency-ai.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# GreenAPI (WhatsApp gateway) — https://green-api.com
# Console: https://console.green-api.com/instanceList
# Prod instance: 7103519997  → base https://7103.api.greenapi.com
# Webhook URL to paste in GreenAPI settings:
#   https://srv1622531.hstgr.cloud/api/whatsapp/webhook
# Webhook auth header sent by server: Authorization: Bearer <GREENAPI_WEBHOOK_TOKEN>
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_BASE_URL=https://YOUR_INSTANCE_NUMBER.api.greenapi.com
GREENAPI_WEBHOOK_TOKEN=

# GreenAPI instance #2 — scanning / operational bot (leave blank until provisioned)
# Once a second GreenAPI instance is created, fill these in on the VPS .env.
# The app boots fine with these unset; scan endpoints return 503 until configured.
GREENAPI_SCAN_ID_INSTANCE=
GREENAPI_SCAN_API_TOKEN=
GREENAPI_SCAN_BASE_URL=

# OpenRouter AI — https://openrouter.ai
# Model IDs: https://openrouter.ai/models
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-3.1-pro-preview

# Google Calendar (OAuth 2.0)
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI must match exactly what's registered in Google Cloud Console.
# Booking URL is the public Calendar appointment-scheduling page sent to clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_BOOKING_URL=

# Gmail OAuth 2.0 (per-staff inbox monitoring)
# Same Google Cloud Console project as Calendar, but needs Gmail API enabled.
# Scopes required: gmail.readonly, gmail.metadata
# Add the redirect URI below to "Authorized redirect URIs" in the OAuth 2.0 client.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Google Workspace OAuth 2.0 (Sheets + Drive + Gmail — agency account)
# Same GCP project; enable Sheets API and Drive API in addition to Gmail.
# Scopes granted: spreadsheets, drive.file, gmail.readonly, gmail.send
# Authorize at: GET /api/integrations/google/authorize (stores refresh_token in system_settings)
GOOGLE_WS_CLIENT_ID=
GOOGLE_WS_CLIENT_SECRET=

# Google Workspace (Sheets/Drive lead mirror)
# Completed intake leads are mirrored to the "לידים חדשים" tab and docs uploaded to Drive.
LEADS_SPREADSHEET_ID=11TwqEQzqh3Yul9dWQfX2s8__yfH0hbcI71f_TF1pAjw
LEADS_SHEET_TAB=לידים חדשים
LEADS_DRIVE_FOLDER_ID=1iwvNhMS2982JhzEemEJdq0-XQdqwGOXv
# Set to false to disable the mirror without removing the code.
LEADS_MIRROR_ENABLED=true

# Timeless.day (meeting recording + transcripts)
# Dashboard: https://app.timeless.day — API keys under Settings > Integrations
TIMELESS_API_KEY=
# Single WhatsApp number that receives the Hebrew meeting summary (owner line).
# Test: 639219909210  |  Prod: 972547725826
SUMMARY_RECIPIENT_PHONE=

# Provider toggles — "stub" disables live API calls during development.
# Email/WhatsApp default to "live".
#EMAIL_PROVIDER=live
#WHATSAPP_PROVIDER=live

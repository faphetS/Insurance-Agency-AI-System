# ============================================================================
# Server environment template.
# Copy to `Server/.env` and fill in real values. Never commit `.env`.
# Schema source of truth: Server/src/config/env.ts
#
# Production deployment: Hostinger VPS
#   IP:        187.127.224.73
#   Hostname:  srv1622531.hstgr.cloud
#   Path:      /opt/app  (Server/ is a subdir)
#   Process:   PM2 → `insurance-api`
#   Deploy:   .github/workflows/deploy-vps.yml (auto on push to main, Server/**)
#   Frontend: https://insurance-agency-ai.vercel.app (Vercel)
# ============================================================================

# Server
NODE_ENV=development
PORT=3000
# Prod values:
#   BACKEND_URL=https://srv1622531.hstgr.cloud
#   FRONTEND_URL=https://insurance-agency-ai.vercel.app
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database — self-hosted PostgreSQL on the Hostinger VPS (same box as the app)
# Prod: DATABASE_URL=postgresql://app:STRONG_PASSWORD@localhost:5432/insurance
DATABASE_URL=postgresql://app:password@localhost:5432/insurance
DATABASE_POOL_MAX=10

# File storage — local filesystem (replaces the Supabase Storage bucket).
# Uploads are written under <STORAGE_DIR>/client-documents and served via signed /files URLs.
STORAGE_DIR=./storage

# Auth — single static bearer token protecting admin/inspector endpoints (min 16 chars).
# Send as: Authorization: Bearer <ADMIN_API_TOKEN>
ADMIN_API_TOKEN=change-me-to-a-long-random-admin-token

# Secret used to HMAC-sign the temporary /files download URLs (min 32 chars)
JWT_SECRET=your-secret-min-32-characters-long-for-file-url-signing

# Rate Limiting (defaults: 100 requests per 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging — fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# CORS (comma-separated origins)
# Prod: ALLOWED_ORIGINS=https://insurance-agency-ai.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Shared inbound webhook token for POST /api/whatsapp/webhook — guards the
# operational (GREENAPI_OP_*) and NOTIFY (GREENAPI_NOTIFY_*) lines. The 945
# conversational GreenAPI instance was retired 2026-07-15; Meta is now the
# sole conversational transport (below).
# Webhook auth: Authorization: Bearer <GREENAPI_WEBHOOK_TOKEN>
GREENAPI_WEBHOOK_TOKEN=

# Meta WhatsApp Cloud API — sole conversational transport.
# Webhook URL for the Meta app dashboard:
#   https://srv1622531.hstgr.cloud/api/whatsapp/meta-webhook
# All blank keeps Meta dormant (conversational bot has no transport).
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
# META_WABA_ID=

# Chatwoot staff inbox (Phase B) — mirrors every conversational message in/out and
# lets an agent take over: an agent reply in the Chatwoot UI is forwarded to the
# customer on WhatsApp and pauses the bot for 1 hour.
# Test values live on the owner's local Docker Chatwoot (v4.15.1); during testing
# CHATWOOT_BASE_URL is the tunnel URL exposing that localhost instance.
# Takeover callback URL to set as the inbox webhook_url in Chatwoot:
#   https://srv1622531.hstgr.cloud/api/chatwoot/callback/<CHATWOOT_CALLBACK_SECRET>
# BOT_TOKEN = the Bot Mirror user's access token; BOT_USER_ID = that user's id
# (the callback filter drops its own mirrored posts by this id — loop safety).
# All blank keeps the mirror + callback fully dormant. Never put real tokens here.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_USER_ID=
CHATWOOT_CALLBACK_SECRET=

# Welcome-image bubble sent ~3-5s after the opening intake message.
# Blank/unset falls back to <BACKEND_URL>/assets/brand.jpeg; set to empty string to disable.
WELCOME_IMAGE_URL=

# Operational GreenAPI line — call reminders (missed/declined calls daily 08:00)
# Leave blank to keep dormant; all three must be set together.
GREENAPI_OP_BASE_URL=
GREENAPI_OP_ID_INSTANCE=
GREENAPI_OP_API_TOKEN=

# Unanswered-WA watcher: test-period toggle only. Set to any non-empty value to disable
# the Sun-Thu 09:00-18:00 Israel watch-window check (so out-of-window testing works). Leave
# BLANK in production — this bypasses a real behavioral guard.
UNANSWERED_WINDOW_DISABLED=

# GreenAPI instance #3 — dedicated operational-notify line. Carries every owner
# notification the operational bot sends (morning digest, call-reminder, commitments,
# unanswered-WA alerts). Leave blank to keep dormant; notifyOwnerOps() no-ops when unset.
GREENAPI_NOTIFY_ID_INSTANCE=
GREENAPI_NOTIFY_API_TOKEN=
GREENAPI_NOTIFY_BASE_URL=

# GreenAPI instance #2 — Didi's personal WhatsApp (scanning + commitment reminders)
# Fill these in once instance #2 is provisioned on GreenAPI.
# Leave blank to keep the feature dormant — the app boots and runs safely without them.
# When set, the system will:
#   - Scan Didi's 1:1 chats once a morning (08:00 Jerusalem) for commitments
#   - Send daily reminder batches and timed alerts to Didi's own self-chat
# Auto-activates with zero code change once all three values are filled in.
GREENAPI_SCAN_ID_INSTANCE=
GREENAPI_SCAN_API_TOKEN=
GREENAPI_SCAN_BASE_URL=

# OpenRouter AI — https://openrouter.ai
# Model IDs: https://openrouter.ai/models
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# Fallback model if AI_MODEL fails (text + image paths retry once with this)
AI_FALLBACK_MODEL=google/gemini-3.1-pro-preview
# AI model for commitment extraction + reminder composition (lighter than AI_MODEL is fine)
COMMITMENT_AI_MODEL=google/gemini-3.1-flash-lite

# Google Calendar (OAuth 2.0)
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI must match exactly what's registered in Google Cloud Console.
# Booking URL is the public booking link sent to clients — can be any provider
# (Google appointment schedule, Calendly, Zoom Scheduler, etc.).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_BOOKING_URL=

# Google Workspace OAuth 2.0 (Sheets + Drive + Gmail — agency account)
# Same GCP project; enable Sheets API and Drive API in addition to Gmail.
# Scopes granted: spreadsheets, drive.file, gmail.readonly, gmail.send
# Authorize at: GET /api/integrations/google/authorize (stores refresh_token in system_settings)
GOOGLE_WS_CLIENT_ID=
GOOGLE_WS_CLIENT_SECRET=

# Google Workspace (Sheets/Drive lead mirror)
# v4.1: buttons 1-8 → LEADS_SHEET_TAB_NEW; button 9 existing-client → LEADS_SHEET_TAB_EXISTING (7 columns A–G).
LEADS_SPREADSHEET_ID=11TwqEQzqh3Yul9dWQfX2s8__yfH0hbcI71f_TF1pAjw
LEADS_SHEET_TAB=לידים חדשים
LEADS_SHEET_TAB_NEW=לידים חדשים
LEADS_SHEET_TAB_EXISTING=לקוח קיים
# Tab names are trim-matched against the live sheet; column F (relevance) drives the
# 5-min relevance mover, which moves rows between these 3 tabs.
LEADS_SHEET_TAB_IRRELEVANT=לא רלוונטי
LEADS_DRIVE_FOLDER_ID=1iwvNhMS2982JhzEemEJdq0-XQdqwGOXv
# Set to false to disable the mirror without removing the code.
LEADS_MIRROR_ENABLED=true

# Timeless.day (meeting recording + transcripts)
# Dashboard: https://app.timeless.day — API keys under Settings > Integrations
TIMELESS_API_KEY=
# Single WhatsApp number that receives the Hebrew meeting summary (owner line).
# Test: 639219909210  |  Prod: 972547725826
SUMMARY_RECIPIENT_PHONE=

# Provider toggles — "stub" disables live API calls during development.
# Email defaults to "live".
#EMAIL_PROVIDER=live

# Staff email notification mode — daily sent-Gmail mention scan (08:00 Jerusalem).
# log  = dry-run: compose emails to PM2 logs, nothing is sent (default, safe for dev/staging)
# send = actually send a summary email to each staff member detected in Didi's sent mail
STAFF_EMAIL_NOTIFY_MODE=log

# Unanswered-WA watcher mode — the only feature that sends WhatsApp FROM Didi's own
# line (944), Sun-Thu 09:00-18:00 Israel time only: after 10 minutes of silence, one
# interactive-buttons auto-reply message ("I'm in a meeting" + 2 buttons). A tap on
# "call me back" is NOT notified immediately — it's aggregated into a single Hebrew
# reminder sent to Didi via the notify line at the next business day's (Sun-Thu) 09:00 job.
# off  = fully dormant: no row tracking, no LLM calls, no sends, zero cost (default)
# log  = dry-run: full pipeline (LLM gate, dedupe, caps, pacing, DB state stamps) runs,
#        but the sends are replaced by log lines
# send = real sends (current production behavior)
UNANSWERED_WA_MODE=off

# ═════════════════════════════════════════════════════════════════════════════
# CLIENT CUTOVER (AnyDesk session) — collect, then flip
# The client's number is already live on Meta and connected to their old
# system. Cutover = point THEIR app's webhook at us. Collect first, flip later.
#
# STEP 0 — sanity check (2 min): business.facebook.com → WhatsApp Manager →
#   the bot number must be managed by a Meta app in THEIR portfolio
#   (Meta-direct). If a partner name shows (360dialog/Twilio/Wati/...) STOP —
#   BSP setup, different integration path, just screenshot everything.
#
# COLLECT — 4 values + 1 token + 1 screenshot:
#   1. WABA ID             → WhatsApp Manager, account overview
#   2. Phone Number ID     → WhatsApp Manager, the number's details    → META_PHONE_NUMBER_ID
#   3. App ID              → developers.facebook.com, their app
#   4. App Secret          → their app → App settings → Basic → Show   → META_APP_SECRET
#      (get yourself added as ADMIN of that app while you're there)
#   5. PERMANENT token     → Business Settings → Users → System users:
#      create system user (admin) → Add assets: the app + the WABA →
#      Generate token with whatsapp_business_messaging +
#      whatsapp_business_management                                    → META_ACCESS_TOKEN
#   6. SCREENSHOT the current webhook config (their app → WhatsApp →
#      Configuration): the old callback URL is the ROLLBACK PLAN, and it
#      tells us what system goes deaf at the flip.
#   7. check payment option for initiated message
#   Optional: 2FA PIN of the number (only ever needed on re-registration —
#   store securely OUTSIDE this repo); status readout (quality rating,
#   messaging tier, business verification, payment method on the WABA —
#   billing needed later for out-of-window utility templates).
#
# FLIP DAY (scheduled, client aware — their old system goes deaf instantly):
#   a. VPS .env: set META_PHONE_NUMBER_ID / META_APP_SECRET / META_ACCESS_TOKEN
#      to the client values (META_VERIFY_TOKEN stays ours) → pm2 restart
#   b. Their app dashboard → WhatsApp → Configuration: callback URL =
#      https://srv1622531.hstgr.cloud/api/whatsapp/meta-webhook, verify token =
#      our META_VERIFY_TOKEN → Verify and save → field "messages" subscribed
#   c. Verify GET /<WABA_ID>/subscribed_apps lists their app (should already —
#      their old system received through it; if empty, POST the same URL.
#      A missing subscription = webhooks silently never arrive, learned 2026-07-14)
#      ⚠️ ALSO check for a SECOND app in that list — a WABA can have multiple
#      subscribed apps, each getting every inbound → 1 inbound = 2 bot replies.
#      If an unknown app shows, that's the old system on its own app: note its
#      ID now, remove it in step (e). (Don't remove on flip day — rollback.)
#   d. Send a test message to the number → bot replies. ROLLBACK = paste the
#      old callback URL from the screenshot back into their dashboard.
#
# STEP (e) — DISCONNECT OLD SYSTEM (T+1–2 days, ONLY after ours is stable):
#   Everything here is done from Meta Business Settings — no access to the old
#   system needed. NOT on flip day: their access IS the rollback plan.
#   e1. If step (c) found a second app: DELETE /<WABA_ID>/subscribed_apps with
#       that app's own token, or easier — Business Settings → Accounts →
#       WhatsApp accounts → the WABA → Connected apps → remove the old app.
#   e2. Kill their SEND ability (proactive/scheduled sends don't need webhooks):
#       Business Settings → Users → System users → find the old system user →
#       revoke its token / remove its access to the WABA + app, or delete it.
#       ⚠️ Do NOT touch the system user WE created in COLLECT step 5.
#   e3. If unsure which token is theirs: WABA → Connected apps + System users →
#       anything that isn't our app/our system user gets removed.
#   e4. Re-test: message the number → exactly ONE reply (ours).
#   After e2 the screenshot-rollback is DEAD — only do this once we're stable.
# ═════════════════════════════════════════════════════════════════════════════
